# Copy to .env.testing.mysql. Keep the working .env and phpunit.xml unchanged.
# Only use a disposable dedicated database: the test suite performs migrate:fresh.
APP_NAME="Nightshift MySQL Validation"
APP_ENV=testing
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8884
APP_CONFIG_CACHE=bootstrap/cache/config.mysql-validation.php
DB_CONNECTION=mysql_validation
DB_URL=
MYSQL_VALIDATION_HOST=127.0.0.1
MYSQL_VALIDATION_PORT=3306
MYSQL_VALIDATION_DATABASE=nightshift_mysql_test
MYSQL_VALIDATION_USERNAME=
MYSQL_VALIDATION_PASSWORD=
# MYSQL_VALIDATION_SOCKET=
# MYSQL_VALIDATION_SSL_CA=
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_MAILER=array
BROADCAST_CONNECTION=null
LOG_CHANNEL=single
# Optional, before first seeding:
# NIGHTSHIFT_DEMO_PASSWORD=
