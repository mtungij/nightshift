<?php

namespace App\Models;

use Carbon\CarbonInterface;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Support\Facades\DB;

/**
 * @property int $id
 * @property int $company_id
 * @property int $category_id
 * @property int $base_unit_id
 * @property string $name
 * @property string $sku
 * @property string|null $barcode
 * @property string|null $brand
 * @property numeric-string $purchase_cost
 * @property numeric-string $minimum_stock
 * @property string|null $image_path
 * @property string|null $image_url
 * @property string $visual_style
 * @property bool $active
 * @property CarbonInterface|null $created_at
 * @property CarbonInterface|null $updated_at
 * @property-read Collection<int, ProductUnit> $sellingUnits
 * @property-read Category $category
 * @property-read Unit $baseUnit
 */
class Product extends TenantModel
{
    // Internal legacy imports/seeders keep a safe General-only mapping. Catalog UI
    // supplies its explicit assignment in the same transaction and skips this initializer.
    public bool $initializeGeneralAvailability = true;

    protected static function booted(): void
    {
        parent::booted();
        static::created(function (Product $product): void {
            if (! $product->initializeGeneralAvailability) {
                return;
            }
            $rows = DB::table('business_units')->where('company_id', $product->company_id)->where('code', 'GENERAL')->pluck('id')->map(fn ($id) => ['company_id' => $product->company_id, 'product_id' => $product->id, 'business_unit_id' => $id, 'available' => true, 'created_at' => now(), 'updated_at' => now()])->all();
            if ($rows) {
                DB::table('business_unit_products')->insert($rows);
            }
        });
    }

    protected $table = 'products';

    protected bool $branchScoped = false;

    protected function casts(): array
    {
        return [...parent::casts(), 'active' => 'boolean'];
    }

    /** @return HasMany<ProductUnit, $this> */
    public function sellingUnits(): HasMany
    {
        return $this->hasMany(ProductUnit::class);
    }

    /** @return BelongsTo<Category, $this> */
    public function category(): BelongsTo
    {
        return $this->belongsTo(Category::class);
    }

    /** @return BelongsTo<Unit, $this> */
    public function baseUnit(): BelongsTo
    {
        return $this->belongsTo(Unit::class, 'base_unit_id');
    }
}
